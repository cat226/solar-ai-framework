# Solar AI Framework — .gitignore

# Model weights (large binary files — do not commit)
weights/*.pt
weights/*.pth
weights/*.joblib
weights/*.pkl

# Prepared/raw training data (never commit datasets)
training/data/

# Ground-level PV research dataset — raw download, normalized copy, split
# materializations, real-world holdout imagery, and heavy per-image reports.
# Small text reports (dataset_audit.md/json, evaluation, manifests) ARE
# committed and are whitelisted below.
datasets/ground_pv_research/raw/
datasets/ground_pv_research/audited/
datasets/ground_pv_research/yolo/
datasets/ground_pv_research/splits/
datasets/ground_pv_research/real_world_holdout/images/
research_runs/
kaggle/ground_pv_dataset/images/
kaggle/ground_pv_dataset/labels/
kaggle/ground_pv_dataset/provenance/
kaggle/ground_pv_dataset/data.yaml
# Condition/defect Kaggle staging package: bulky image/label tree + the copied
# provenance bundle are regenerable (scripts/build_condition_kaggle_package.py).
# PACKAGE_SUMMARY.json / dataset-metadata.json / README.md ARE committed.
kaggle/ground_condition_dataset/images/
kaggle/ground_condition_dataset/labels/
kaggle/ground_condition_dataset/provenance/
kaggle/ground_condition_dataset/data.yaml
!datasets/ground_pv_research/reports/
!datasets/ground_pv_research/reports/**
# ...except the uncapped audit dump (tens of MB of near-dup pair lists)
datasets/ground_pv_research/reports/*_full.json
# Split provenance manifests / READMEs ARE committed (small text, needed to
# trace every derived image and reproduce the leakage-clean split); only the
# bulk image/label trees under splits/ stay ignored.
!datasets/ground_pv_research/splits/
!datasets/ground_pv_research/splits/**/
!datasets/ground_pv_research/splits/**/*.csv
!datasets/ground_pv_research/splits/**/*.md
datasets/ground_pv_research/splits/**/images/
datasets/ground_pv_research/splits/**/labels/
# Candidate defect datasets (discovery/audit phase): raw Roboflow downloads
# and the per-image fingerprint dumps are bulky and regenerable. The small
# metadata / manifests / reports / overlap summaries ARE committed.
datasets/ground_pv_research/candidate_defects/raw/
datasets/ground_pv_research/candidate_defects/overlap/_fingerprints/

# Unified condition/defect research dataset (S1 + S3 -> 5 condition classes):
# the materialized image/label tree is bulky and regenerable via
# `python scripts/build_condition_dataset.py --overwrite`. The manifests,
# splits, reports, taxonomy and raw_refs (all small-ish text) ARE committed
# so every derived image stays traceable and the split is reproducible.
datasets/ground_pv_research/condition/images/

# Ultralytics YOLO training runs and pretrained-checkpoint downloads
runs/
training/detection/runs/
*.pt

# Local runtime app data (SQLite inspection history — per-deployment, not project content)
data/

# Locally-staged Kaggle kernel packages (generated by training/cloud/kaggle, per-machine)
training/cloud/runs/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Testing / Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Secrets — NEVER commit
.env
.streamlit/secrets.toml

# Environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Local AI-tooling state (not project content)
.claude/
.kilo/

# OS
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml

# one-shot Kaggle upload staging (regenerable)
kaggle/ground_condition_upload/

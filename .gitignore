# Solar AI Framework — .gitignore

# Model weights (large binary files — do not commit)
weights/*.pt
weights/*.pth
weights/*.joblib
weights/*.pkl

# Prepared/raw training data (never commit datasets)
training/data/

# Ground-level PV research dataset — raw download, normalized copy, split
# materializations, real-world holdout imagery, and heavy per-image reports.
# Small text reports (dataset_audit.md/json, evaluation, manifests) ARE
# committed and are whitelisted below.
datasets/ground_pv_research/raw/
datasets/ground_pv_research/audited/
datasets/ground_pv_research/yolo/
datasets/ground_pv_research/splits/
datasets/ground_pv_research/real_world_holdout/images/
research_runs/
kaggle/ground_pv_dataset/images/
kaggle/ground_pv_dataset/labels/
!datasets/ground_pv_research/reports/
!datasets/ground_pv_research/reports/**
# ...except the uncapped audit dump (tens of MB of near-dup pair lists)
datasets/ground_pv_research/reports/*_full.json

# Ultralytics YOLO training runs and pretrained-checkpoint downloads
runs/
training/detection/runs/
*.pt

# Local runtime app data (SQLite inspection history — per-deployment, not project content)
data/

# Locally-staged Kaggle kernel packages (generated by training/cloud/kaggle, per-machine)
training/cloud/runs/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Testing / Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Secrets — NEVER commit
.env
.streamlit/secrets.toml

# Environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Local AI-tooling state (not project content)
.claude/
.kilo/

# OS
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml

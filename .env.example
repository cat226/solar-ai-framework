# Solar AI Framework — Environment secrets template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control (it is git-ignored).
#
# The project-root .env is loaded automatically (python-dotenv, override=False)
# when utils.config is imported. A real shell environment variable always wins.

# OpenWeatherMap API key
# Get yours at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Roboflow API key — required only for the ground-level PV research dataset
# download (scripts/download_ground_pv_dataset.py). Get it from
# https://app.roboflow.com -> Settings -> API Keys (Private API Key).
ROBOFLOW_API_KEY=your_roboflow_api_key_here
